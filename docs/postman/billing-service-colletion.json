      "name": "Orçamentos",
      "item": [
        {
          "name": "Listar Orçamentos por OS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\",function(){pm.response.to.have.status(200);});",
                  "pm.test(\"Tempo de resposta < 5000ms\",function(){pm.expect(pm.response.responseTime).to.be.below(5000);});",
                  "var json=pm.response.json();var item=Array.isArray(json)?json[0]:(json&&json.content?json.content[0]:json);",
                  "if(item&&item.id){pm.environment.set(\"orcamentoId\",item.id);}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAtendente}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orcamentos?osId={{osId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orcamentos"
              ],
              "query": [
                {
                  "key": "osId",
                  "value": "{{osId}}"
                }
              ]
            },
            "description": "Lista os orçamentos de uma OS. Role: CLIENTE, ATENDENTE ou GERENTE."
          },
          "response": []
        },
