MERCADO_PAGO_HTTP_TIMEOUT=5s
MERCADO_PAGO_SIGNATURE_TOLERANCE=5m
MERCADO_PAGO_BATCH_SIZE=10
MERCADO_PAGO_WORKER_DELAY=5s
MERCADO_PAGO_LEASE_DURATION=2m
MERCADO_PAGO_SYNC_INTERVAL=1m
BILLING_SECURITY_ROLES=USER
